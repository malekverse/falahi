{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "supabase": {
      "type": "local",
      "command": [
        "npx", "-y", "@supabase/mcp-server-supabase@latest",
        "--project-ref=nrysujlctrhjucvdtivq"
      ],
      "environment": {
        "SUPABASE_ACCESS_TOKEN": "sbp_YOUR_NEW_ROTATED_TOKEN"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--headless", "--isolated"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": { "CONTEXT7_API_KEY": "ctx7sk-YOUR_NEW_ROTATED_KEY" }
    }
  },
  "permission": {
    "doom_loop": "allow",
    "external_directory": "deny",
    "bash": {
      "rm -rf *": "deny",
      "git push --force*": "deny",
      "supabase db reset*": "deny",
      "supabase projects delete*": "deny",
      "eas build*": "deny",
      "vercel --prod*": "deny",
      "vercel deploy --prod*": "deny"
    }
  }
}